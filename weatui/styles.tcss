Screen {
    background: #0C1F17;
    color: #DEF4E5;
}

#shell {
    height: 1fr;
    width: 100%;
    padding: 1 2;
}

#topbar {
    height: 3;
    width: 100%;
    padding: 0 1;
    border-bottom: solid #2F6B4C;
    color: #7BD88F;
    text-style: bold;
    content-align: center middle;
}

#body {
    height: 1fr;
    width: 100%;
}

#sidebar {
    width: 30;
    min-width: 16;
    height: 1fr;
    padding: 1 1;
    border-right: solid #2F6B4C;
}

#details {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

.section {
    height: auto;
    color: #9CB8A3;
    text-style: bold;
    margin-top: 1;
}

#cities {
    height: 1fr;
    min-height: 4;
    background: #122A1F;
    border: round #2F6B4C;
}

Button {
    width: auto;
    min-width: 12;
    content-align: center middle;
    text-align: center;
}

ListView > ListItem {
    padding: 0 1;
}

ListView > ListItem.-highlight {
    background: #7BD88F;
    color: #07140D;
}

#current {
    height: auto;
    min-height: 8;
    padding: 1;
    border: round #2F6B4C;
    background: #122A1F;
    color: #DEF4E5;
}

#days {
    height: 10;
    scrollbar-size-vertical: 0;
    scrollbar-size-horizontal: 0;
    border: round #2F6B4C;
    background: #122A1F;
    color: #DEF4E5;
}

#hours {
    height: auto;
    color: #9CB8A3;
}

#side-hint {
    height: auto;
    color: #6F917B;
    margin-top: 1;
}

#statusbar {
    height: 2;
    width: 100%;
    padding: 0 1;
    border-top: solid #2F6B4C;
    color: #9CB8A3;
    content-align: left middle;
}

#add-card {
    width: 60;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: thick #7BD88F;
    background: #122A1F;
}

#add-title {
    height: auto;
    color: #7BD88F;
    text-style: bold;
}

#city-input {
    margin: 1 0;
}

#add-hint {
    height: auto;
    color: #9CB8A3;
}

.theme-greenit { background: #0C1F17; color: #DEF4E5; }
.theme-greenit ListView > ListItem.-highlight { background: #7BD88F; color: #07140D; }
.theme-greenit #topbar { color: #7BD88F; border-bottom: solid #2F6B4C; }
.theme-greenit #cities, .theme-greenit #current, .theme-greenit #days, .theme-greenit #add-card { background: #122A1F; border: round #2F6B4C; color: #DEF4E5; }

.theme-bluney { background: #0E1B2E; color: #E3EFF9; }
.theme-bluney ListView > ListItem.-highlight { background: #7DBBFF; color: #07101E; }
.theme-bluney #topbar { color: #7DBBFF; border-bottom: solid #2C4E78; }
.theme-bluney #sidebar { border-right: solid #2C4E78; }
.theme-bluney #cities, .theme-bluney #current, .theme-bluney #days, .theme-bluney #add-card { background: #122A46; border: round #2C4E78; color: #E3EFF9; }
.theme-bluney #statusbar { border-top: solid #2C4E78; color: #9DB8D2; }

.theme-yellen { background: #171408; color: #F3E8B8; }
.theme-yellen ListView > ListItem.-highlight { background: #F2D14E; color: #171408; }
.theme-yellen #topbar { color: #F2D14E; border-bottom: solid #6E5B25; }
.theme-yellen #sidebar { border-right: solid #6E5B25; }
.theme-yellen #cities, .theme-yellen #current, .theme-yellen #days, .theme-yellen #add-card { background: #24200C; border: round #6E5B25; color: #F3E8B8; }
.theme-yellen #statusbar { border-top: solid #6E5B25; color: #A79765; }
.theme-yellen .section, .theme-yellen #side-hint, .theme-yellen #hours { color: #A79765; }

.theme-mono { background: #0B0B0B; color: #F0F0F0; }
.theme-mono ListView > ListItem.-highlight { background: #F0F0F0; color: #0B0B0B; }
.theme-mono #topbar { color: #FFFFFF; border-bottom: solid #444444; }
.theme-mono #sidebar { border-right: solid #444444; }
.theme-mono #cities, .theme-mono #current, .theme-mono #days, .theme-mono #add-card { background: #161616; border: round #444444; color: #F0F0F0; }
.theme-mono #statusbar { border-top: solid #444444; color: #999999; }

.theme-gruvbox { background: #282828; color: #EBDBB2; }
.theme-gruvbox ListView > ListItem.-highlight { background: #FE8019; color: #282828; }
.theme-gruvbox #topbar { color: #FE8019; border-bottom: solid #504945; }
.theme-gruvbox #sidebar { border-right: solid #504945; }
.theme-gruvbox #cities, .theme-gruvbox #current, .theme-gruvbox #days, .theme-gruvbox #add-card { background: #3C3836; border: round #504945; color: #EBDBB2; }
.theme-gruvbox #statusbar { border-top: solid #504945; color: #A89984; }
.theme-gruvbox .section, .theme-gruvbox #side-hint, .theme-gruvbox #hours { color: #A89984; }

.theme-catppuccin { background: #1E1E2E; color: #CDD6F4; }
.theme-catppuccin ListView > ListItem.-highlight { background: #CBA6F7; color: #1E1E2E; }
.theme-catppuccin #topbar { color: #CBA6F7; border-bottom: solid #45475A; }
.theme-catppuccin #sidebar { border-right: solid #45475A; }
.theme-catppuccin #cities, .theme-catppuccin #current, .theme-catppuccin #days, .theme-catppuccin #add-card { background: #313244; border: round #45475A; color: #CDD6F4; }
.theme-catppuccin #statusbar { border-top: solid #45475A; color: #A6ADC8; }
.theme-catppuccin .section, .theme-catppuccin #side-hint, .theme-catppuccin #hours { color: #A6ADC8; }

.theme-tokyonight { background: #1A1B26; color: #C0CAF5; }
.theme-tokyonight ListView > ListItem.-highlight { background: #7AA2F7; color: #1A1B26; }
.theme-tokyonight #topbar { color: #7AA2F7; border-bottom: solid #3B4261; }
.theme-tokyonight #sidebar { border-right: solid #3B4261; }
.theme-tokyonight #cities, .theme-tokyonight #current, .theme-tokyonight #days, .theme-tokyonight #add-card { background: #292E42; border: round #3B4261; color: #C0CAF5; }
.theme-tokyonight #statusbar { border-top: solid #3B4261; color: #A9B1D6; }
.theme-tokyonight .section, .theme-tokyonight #side-hint, .theme-tokyonight #hours { color: #A9B1D6; }

#pick-card {
    width: 70;
    max-width: 100%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick #7BD88F;
    background: #122A1F;
}

#matches {
    height: auto;
    min-height: 4;
    max-height: 12;
    margin: 1 0;
    background: #0C1F17;
    border: round #2F6B4C;
}

#matches > ListItem {
    padding: 0 1;
}

#matches > ListItem.-highlight {
    background: #7BD88F;
    color: #07140D;
}

#confirm-card {
    width: 60;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: thick #E06C75;
    background: #2A1215;
}

#confirm-city {
    height: auto;
    padding: 1 0;
    color: #F5D6D8;
}

#compare-card {
    width: 92%;
    max-width: 100%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick #61D7FF;
    background: #0B1B24;
}

#compare-table {
    height: auto;
    min-height: 3;
    max-height: 16;
    margin: 1 0;
}

/* narrow fallback: <64 cols, sidebar shrinks to keep details readable */
.narrow #sidebar { width: 20; }
.narrow #shell { padding: 0 1; }
.narrow #details { padding: 0 1; }
.narrow #topbar { content-align: left middle; }
.narrow #side-hint { display: none; }
.narrow #compare-card { width: 96%; }

/* dialogs sit centred instead of pinned to the top-left corner */
ModalScreen {
    align: center middle;
}

ModalScreen > Vertical {
    height: auto;
    max-height: 100%;
}
